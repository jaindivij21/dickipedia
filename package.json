{
  "name": "dickipedia",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Open-source accountability hub for India's elected Lok Sabha MPs (18th Lok Sabha, 2024). Public records only.",
  "license": "MIT",
  "scripts": {
    "ingest": "tsx pipeline/ingest.ts",
    "rebuild": "tsx pipeline/ingest.ts --build",
    "assert:canonical": "tsx pipeline/build/assert.ts",
    "test": "tsx --test pipeline/engine/runner.test.ts",
    "eci": "tsx pipeline/ingest.ts --sources eci",
    "prs": "tsx pipeline/ingest.ts --sources prs",
    "sansad": "tsx pipeline/ingest.ts --sources sansad",
    "myneta": "tsx pipeline/ingest.ts --sources myneta",
    "myneta_gap": "tsx pipeline/ingest.ts --sources myneta_gap",
    "wealth": "tsx pipeline/ingest.ts --sources wealth",
    "bonds": "tsx pipeline/ingest.ts --sources bonds",
    "mplads": "tsx pipeline/ingest.ts --sources mplads",
    "photos": "tsx pipeline/ingest.ts --sources photos",
    "party_symbols": "tsx pipeline/ingest.ts --sources party_symbols",
    "myneta_deep": "tsx pipeline/ingest.ts --sources myneta_deep",
    "myneta_history": "tsx pipeline/ingest.ts --sources myneta_history",
    "prs_mptrack": "tsx pipeline/ingest.ts --sources prs_mptrack",
    "sansad_api": "tsx pipeline/ingest.ts --sources sansad_api",
    "wikipedia": "tsx pipeline/ingest.ts --sources wikipedia",
    "party_contact": "tsx pipeline/ingest.ts --sources party_contact",
    "latest_news": "tsx pipeline/ingest.ts --sources latest_news",
    "myneta_serious": "tsx pipeline/ingest.ts --sources myneta_serious",
    "canonical": "tsx pipeline/ingest.ts --stages canonical",
    "merge": "tsx pipeline/ingest.ts --stages merge",
    "inferences": "tsx pipeline/ingest.ts --stages inferences",
    "publish": "tsx pipeline/ingest.ts --stages publish",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.2.0",
    "fastest-levenshtein": "^1.0.16",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
