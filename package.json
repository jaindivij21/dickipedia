{
  "name": "dickipedia",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Open-source accountability hub for India's elected Lok Sabha MPs (18th Lok Sabha, 2024). Public records only.",
  "license": "MIT",
  "scripts": {
    "eci": "tsx pipeline/01_eci_spine.ts",
    "prs": "tsx pipeline/02_prs_vonter.ts && tsx pipeline/lib/stamp.ts prs",
    "sansad": "tsx pipeline/03_sansad.ts && tsx pipeline/lib/stamp.ts sansad",
    "myneta": "tsx pipeline/04_myneta.ts",
    "myneta_gap": "tsx pipeline/08_myneta_gap.ts",
    "wealth": "tsx pipeline/05_myneta_wealth.ts",
    "bonds": "tsx pipeline/06_bonds.ts",
    "mplads": "tsx pipeline/07_mplads.ts && tsx pipeline/lib/stamp.ts mplads",
    "photos": "tsx pipeline/09_photos.ts",
    "party_symbols": "tsx pipeline/09_party_symbols.ts",
    "canonical": "tsx pipeline/10_canonical.ts",
    "myneta_deep": "tsx pipeline/11_myneta_deep.ts",
    "myneta_history": "tsx pipeline/12_myneta_history.ts",
    "prs_mptrack": "tsx pipeline/13_prs_mptrack.ts && tsx pipeline/lib/stamp.ts prs",
    "sansad_api": "tsx pipeline/14_sansad_api.ts && tsx pipeline/lib/stamp.ts sansad",
    "wikipedia": "tsx pipeline/15_wikipedia.ts && tsx pipeline/lib/stamp.ts wikipedia",
    "party_contact": "tsx pipeline/16_party_contact.ts",
    "latest_news": "tsx pipeline/19_latest_news.ts && tsx pipeline/lib/stamp.ts news",
    "myneta_serious": "tsx pipeline/20_myneta_serious.ts",
    "merge": "tsx pipeline/17_merge.ts",
    "inferences": "tsx pipeline/18_inferences.ts",
    "publish": "tsx pipeline/21_publish.ts",
    "rebuild": "npm run canonical && npm run merge && npm run inferences && npm run publish",
    "assert:canonical": "tsx pipeline/assert_canonical.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.2.0",
    "fastest-levenshtein": "^1.0.16",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
